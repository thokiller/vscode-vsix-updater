{
  "name": "vsix-updater",
  "displayName": "VSIX Updater",
  "description": "Installs and updates sideloaded VSIX extensions from GitHub releases, with user approval.",
  "version": "0.0.2",
  "publisher": "local",
  "license": "GPL-2.0-only",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/thokiller/vscode-vsix-updater"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "vsix",
    "updater",
    "github",
    "sideload"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "check": "node --check extension.js && node --check lib\\version.js && node --check lib\\sources.js && node --check lib\\config.js && node --check lib\\github.js && node --check lib\\vsix.js && node --check lib\\state.js && node --check lib\\updater.js",
    "test": "node --test test\\*.test.js",
    "test:extension": "node test\\runExtensionTests.js",
    "test:sandbox": "node test\\probeSandbox.js",
    "vscode:prepublish": "npm run check",
    "package": "npx --yes @vscode/vsce@4.1.1 package"
  },
  "devDependencies": {
    "@vscode/test-electron": "2.5.2"
  },
  "contributes": {
    "commands": [
      {
        "command": "vsixUpdater.checkForUpdates",
        "title": "VSIX Updater: Check for Updates",
        "icon": "$(cloud-download)"
      },
      {
        "command": "vsixUpdater.addRepository",
        "title": "VSIX Updater: Add GitHub Repository",
        "icon": "$(add)"
      },
      {
        "command": "vsixUpdater.openConfig",
        "title": "VSIX Updater: Open Configuration File",
        "icon": "$(gear)"
      }
    ]
  }
}
